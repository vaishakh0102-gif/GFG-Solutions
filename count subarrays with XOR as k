class Solution {
  public:
    long subarrayXor(vector<int> &nums, int k) {
        long long cnt=0;
        long long xr=0;
        unordered_map<int,int>mpp;
        mpp[0]=1;
        int n=nums.size();
        for(int i=0;i<n;i++){
            xr=xr^nums[i];
            long long val=xr^k;
            
            cnt+=mpp[val];
            
            mpp[xr]++;
            
        }
        return cnt;
        // code here
        
    }
};
